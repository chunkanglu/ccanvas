{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccanvas Pi",
  "version": "0.5.1",
  "identifier": "io.github.chunkanglu.ccanvas-pi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ccanvas Pi",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/pi-companion-extension.ts": "companion/scripts/pi-companion-extension.ts",
      "../src/lib/pi-companion-protocol.ts": "companion/src/lib/pi-companion-protocol.ts"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
