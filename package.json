{
  "name": "ccanvas",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "test:stage0": "node --test tests/stage0.test.mjs tests/stage0-probe.test.mjs",
    "test:phase1": "node --test tests/phase1.test.mjs",
    "test:phase2": "node --test tests/phase2-protocol.test.mjs tests/phase2-companion.test.mjs tests/phase2-runtime.test.mjs tests/phase2-agent-runtime.test.mjs",
    "test:phase3": "node --test tests/phase3-agent-ux.test.mjs",
    "test:app-install": "node --test tests/app-install.test.mjs",
    "probe:pi": "python3 scripts/probe-pi-rpc.py",
    "probe:pi:tui": "python3 scripts/probe-pi-tui.py",
    "probe:pi:companion": "python3 scripts/probe-pi-companion.py",
    "probe:terminal": "python3 scripts/probe-terminal-editing.py",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/pty-server.mjs",
    "start": "concurrently -n \"pty,web\" -c \"#e8795a,#6db5a8\" \"npm run server\" \"npm run dev\"",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "node scripts/build-app.mjs",
    "app:install": "node scripts/build-app.mjs --debug",
    "app:bundle": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "h5wasm": "^0.10.2",
    "hyparquet": "^1.26.0",
    "hyparquet-compressors": "^1.1.1",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.0.7",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
